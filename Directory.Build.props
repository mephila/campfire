<Project>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Authors>mephila</Authors>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <GameDir Condition="'$(GameDir)' == ''">$(COZY_CAMPFIRE_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' And '$(OS)' == 'Windows_NT'">C:\Program Files (x86)\Steam\steamapps\common\Cozy Campfire Club Demo</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Cozy Campfire Club Demo</GameDir>
    <ManagedDir>$(GameDir)/Cozy Campfire Club_Data/Managed</ManagedDir>
    <PluginsDir>$(GameDir)/BepInEx/plugins</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CheckGame" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(ManagedDir)/Assembly-CSharp.dll')">
    <Error Text="cant find the game at $(GameDir). set COZY_CAMPFIRE_GAME_DIR to the Cozy Campfire Club Demo folder, or build with -p:GameDir=..." />
  </Target>

  <Target Name="CopyToGame" AfterTargets="Build" Condition="'$(CopyToGame)' != 'false' And Exists('$(PluginsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
    <Message Importance="high" Text="copied $(TargetFileName) to $(PluginsDir)" />
  </Target>

</Project>
